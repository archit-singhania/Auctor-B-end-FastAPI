      "Credentials": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "minLength": 5,
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 10,
            "title": "Password"
          },
          "handle": {
            "type": "string",
            "maxLength": 32,
            "title": "Handle",
            "default": ""
          },
          "display_name": {
            "type": "string",
            "maxLength": 80,
            "title": "Display Name",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "Credentials"
      },
      "CvPatch": {
        "properties": {
          "data": {
            "additionalProperties": true,
            "type": "object",
            "title": "Data"
          },
          "note": {
            "type": "string",
            "maxLength": 200,
            "title": "Note",
            "default": "Edited CV"
          }
        },
        "type": "object",
        "required": [
          "data"
        ],
        "title": "CvPatch"
      },
      "Decision": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "note": {
            "type": "string",

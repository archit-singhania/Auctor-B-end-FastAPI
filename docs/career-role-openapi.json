          "url": {
            "type": "string",
            "maxLength": 2000,
            "title": "Url",
            "default": ""
          },
          "detail": {
            "additionalProperties": true,
            "type": "object",
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "kind",
          "title"
        ],
        "title": "EvidenceInput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Milestone": {
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Id"
          },
          "title": {
            "type": "string",
            "maxLength": 160,
            "minLength": 1,
            "title": "Title"
          },
          "date": {
            "type": "string",
            "format": "date",
            "title": "Date"
          },
          "kind": {
            "type": "string",
            "enum": [
              "project",
              "experience",
              "outcome"
            ],
            "title": "Kind",
            "default": "project"
          },
          "narrative": {
            "type": "string",
            "maxLength": 4000,
            "title": "Narrative",
            "default": ""
          },
          "annotation": {
            "type": "string",
            "maxLength": 500,
            "title": "Annotation",
            "default": ""
          },
          "visible": {
            "type": "boolean",
            "title": "Visible",
            "default": false
          },
          "evidence_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Evidence Ids"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "date"
        ],
        "title": "Milestone"
      },
      "ProfilePatch": {
        "properties": {
          "display_name": {
            "type": "string",
            "maxLength": 80,
            "title": "Display Name"
          },
          "bio": {
            "type": "string",
            "maxLength": 1000,
            "title": "Bio",
            "default": ""
          },
          "discoverable": {
            "type": "boolean",
            "title": "Discoverable",
            "default": false
          },
          "preferences": {
            "additionalProperties": true,
            "type": "object",
            "title": "Preferences"
          }
        },
        "type": "object",
        "required": [
          "display_name"
        ],
        "title": "ProfilePatch"
      },
      "Requirement": {
        "properties": {
          "skill": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Skill"
          },
          "priority": {
            "type": "string",
            "enum": [
              "required",
              "preferred"
            ],
            "title": "Priority",
            "default": "required"
          },
          "weight": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 10.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Weight"
          }
        },
        "type": "object",
        "required": [
          "skill"
        ],
        "title": "Requirement"
      },
      "RoleDocument": {
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Revision",
            "default": 0
          },
          "title": {
            "type": "string",
            "maxLength": 160,
            "minLength": 1,
            "title": "Title"
          },
          "description": {
            "type": "string",
            "maxLength": 20000,
            "title": "Description",
            "default": ""
          },
          "reviewed": {
            "type": "boolean",
            "title": "Reviewed",
            "default": false
          },
          "requirements": {
            "items": {
              "$ref": "#/components/schemas/Requirement"
            },
            "type": "array",
            "maxItems": 50,
            "title": "Requirements"
          }
        },
        "type": "object",
        "required": [
          "title"
        ],
        "title": "RoleDocument"
      },
      "StoryPatch": {
        "properties": {
          "revision": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Revision"
          },
          "milestones": {
            "items": {
              "$ref": "#/components/schemas/Milestone"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Milestones"
          }
        },
        "type": "object",
        "required": [
          "revision"
        ],
        "title": "StoryPatch"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }

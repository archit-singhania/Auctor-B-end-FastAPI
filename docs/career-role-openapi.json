            "minLength": 10,
            "title": "Note"
          }
        },
        "type": "object",
        "required": [
          "status",
          "note"
        ],
        "title": "Decision"
      },
      "EvidenceInput": {
        "properties": {
          "kind": {
            "type": "string",
            "title": "Kind"
          },
          "title": {
            "type": "string",
            "maxLength": 200,

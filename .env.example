# PostgreSQL/API configuration. Never commit .env or .env.local.
DATABASE_URL=postgresql://postgres:replace-with-local-password@localhost:5432/demo_db
DB_SCHEMA=auctor
ALLOWED_ORIGINS=http://localhost:8080
WEB_URL=http://localhost:8080
STORAGE_PATH=_data
APP_ENV=development
# Production only: exact HTTPS API origin + existing private persistent volume.
PUBLIC_API_URL=
STORAGE_VOLUME_PATH=
# Railway supplies RAILWAY_VOLUME_MOUNT_PATH when a volume is attached.
# Optional AI extraction. Heuristic parsing works without credentials.
OPENAI_API_KEY=
# GitHub OAuth app callback must exactly match GITHUB_REDIRECT_URI.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/api/github/callback
# Reviewer roles require the private `python -m app.manage grant-reviewer` command.
WEIGHT_GITHUB=0.25
WEIGHT_LEETCODE=0.15
WEIGHT_BADGES=0.30
WEIGHT_PROJECTS=0.15
WEIGHT_EXPERIENCE=0.15
